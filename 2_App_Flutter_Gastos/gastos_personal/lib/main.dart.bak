import 'package:flutter/material.dart';
import 'package:intl/intl.dart';
import 'package:fl_chart/fl_chart.dart';

void main() => runApp(const GastosApp());

class Gasto {
  final String id;
  final String concepto;
  final double monto;
  final DateTime fecha;
  final String categoria;

  Gasto({
    required this.id,
    required this.concepto,
    required this.monto,
    required this.fecha,
    required this.categoria,
  });
}

class GastosApp extends StatelessWidget {
  const GastosApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'Gastos Personales',
      debugShowCheckedModeBanner: false,
      theme: ThemeData(
        colorScheme: ColorScheme.fromSeed(seedColor: Colors.deepPurple),
        useMaterial3: true,
      ),
      home: const HomeGastos(),
    );
  }
}

class HomeGastos extends StatefulWidget {
  const HomeGastos({super.key});

  @override
  State<HomeGastos> createState() => _HomeGastosState();
}

class _HomeGastosState extends State<HomeGastos> {
  final List<Gasto> _gastos = [
    Gasto(id: '1', concepto: 'Mercado', monto: 185000, fecha: DateTime.now().subtract(const Duration(days: 2)), categoria: 'Comida'),
    Gasto(id: '2', concepto: 'Transporte', monto: 12000, fecha: DateTime.now().subtract(const Duration(days: 1)), categoria: 'Transporte'),
    Gasto(id: '3', concepto: 'Internet', monto: 85000, fecha: DateTime.now(), categoria: 'Servicios'),
  ];

  final _conceptoCtrl = TextEditingController();
  final _montoCtrl = TextEditingController();
  String _categoria = 'Comida';

  final List<String> _categorias = ['Comida', 'Transporte', 'Servicios', 'Ocio', 'Otros'];
  final Map<String, Color> _colores = {
    'Comida': Colors.orange,
    'Transporte': Colors.blue,
    'Servicios': Colors.red,
    'Ocio': Colors.green,
    'Otros': Colors.grey,
  };

  double get total => _gastos.fold(0, (sum, g) => sum + g.monto);

  void _agregarGasto() {
    final monto = double.tryParse(_montoCtrl.text) ?? 0;
    if (_conceptoCtrl.text.isEmpty || monto <= 0) return;

    setState(() {
      _gastos.insert(
        0,
        Gasto(
          id: DateTime.now().millisecondsSinceEpoch.toString(),
          concepto: _conceptoCtrl.text,
          monto: monto,
          fecha: DateTime.now(),
          categoria: _categoria,
        ),
      );
    });
    _conceptoCtrl.clear();
    _montoCtrl.clear();
  }

  Map<String, double> _totalesPorCategoria() {
    final map = <String, double>{};
    for (final g in _gastos) {
      map[g.categoria] = (map[g.categoria] ?? 0) + g.monto;
    }
    return map;
  }

  @override
  Widget build(BuildContext context) {
    final totales = _totalesPorCategoria();

    return Scaffold(
      appBar: AppBar(
        title: const Text('Mis Gastos'),
        centerTitle: true,
      ),
      body: Padding(
        padding: const EdgeInsets.all(16),
        child: Column(
          children: [
            Card(
              child: Padding(
                padding: const EdgeInsets.all(16),
                child: Column(
                  children: [
                    Text('Total gastado', style: Theme.of(context).textTheme.titleMedium),
                    const SizedBox(height: 8),
                    Text(
                      NumberFormat.currency(locale: 'es_CO', symbol: '\$').format(total),
                      style: Theme.of(context).textTheme.headlineMedium?.copyWith(fontWeight: FontWeight.bold),
                    ),
                  ],
                ),
              ),
            ),
            const SizedBox(height: 16),
            if (totales.isNotEmpty)
              SizedBox(
                height: 180,
                child: PieChart(
                  PieChartData(
                    sectionsSpace: 2,
                    centerSpaceRadius: 40,
                    sections: totales.entries.map((e) {
                      final porcentaje = e.value / total;
                      return PieChartSectionData(
                        color: _colores[e.key] ?? Colors.purple,
                        value: e.value,
                        title: '${(porcentaje * 100).toStringAsFixed(0)}%',
                        radius: 50,
                        titleStyle: const TextStyle(fontSize: 12, fontWeight: FontWeight.bold, color: Colors.white),
                      );
                    }).toList(),
                  ),
                ),
              ),
            const SizedBox(height: 8),
            Wrap(
              spacing: 8,
              children: totales.keys.map((cat) => Chip(
                label: Text(cat),
                backgroundColor: _colores[cat]?.withValues(alpha: 0.2),
              )).toList(),
            ),
            const SizedBox(height: 16),
            Row(
              children: [
                Expanded(
                  flex: 2,
                  child: TextField(
                    controller: _conceptoCtrl,
                    decoration: const InputDecoration(labelText: 'Concepto'),
                  ),
                ),
                const SizedBox(width: 8),
                Expanded(
                  child: TextField(
                    controller: _montoCtrl,
                    keyboardType: TextInputType.number,
                    decoration: const InputDecoration(labelText: 'Monto'),
                  ),
                ),
              ],
            ),
            const SizedBox(height: 8),
            Row(
              children: [
                Expanded(
                  child: DropdownButtonFormField<String>(
                    initialValue: _categoria,
                    items: _categorias.map((c) => DropdownMenuItem(value: c, child: Text(c))).toList(),
                    onChanged: (v) => setState(() => _categoria = v!),
                    decoration: const InputDecoration(labelText: 'Categoría'),
                  ),
                ),
                const SizedBox(width: 8),
                ElevatedButton.icon(
                  onPressed: _agregarGasto,
                  icon: const Icon(Icons.add),
                  label: const Text('Agregar'),
                ),
              ],
            ),
            const SizedBox(height: 16),
            const Divider(),
            Expanded(
              child: ListView.builder(
                itemCount: _gastos.length,
                itemBuilder: (_, i) {
                  final g = _gastos[i];
                  return ListTile(
                    leading: CircleAvatar(
                      backgroundColor: _colores[g.categoria],
                      child: Text(g.categoria[0], style: const TextStyle(color: Colors.white)),
                    ),
                    title: Text(g.concepto),
                    subtitle: Text(DateFormat('dd/MM/yyyy').format(g.fecha)),
                    trailing: Text(NumberFormat.currency(locale: 'es_CO', symbol: '\$').format(g.monto)),
                  );
                },
              ),
            ),
          ],
        ),
      ),
    );
  }
}
